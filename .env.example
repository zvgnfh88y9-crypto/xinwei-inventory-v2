# Public frontend env (safe to expose only after provider access/RLS is configured)
# VITE_* values are bundled into the browser. Do not put server secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Provider runtime env names (set in provider UI or CLI prompts; do not paste values in chat)
SUPABASE_ANON_KEY=

# Server-only env names (never paste values in chat; set in .env.local or provider env UI)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
