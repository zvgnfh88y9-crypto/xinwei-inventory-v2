.page { min-height: 100vh; padding-bottom: 60rpx; }
.loading { height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; color: #64748b; }
.spinner { width: 54rpx; height: 54rpx; border: 6rpx solid #dbeafe; border-top-color: #2563eb; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.hero { display: flex; align-items: center; gap: 24rpx; padding: 44rpx 36rpx; background: linear-gradient(135deg,#2563eb,#4338ca); color: white; }
.brand { width: 86rpx; height: 86rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: white; color: #2563eb; font-size: 30rpx; font-weight: 900; }
.title,.subtitle,.section-title,.hint,.type-title,.type-help,.recent-title,.recent-name,.recent-file,.form-label,.form-title,.field-label,.photo-title,.photo-help { display: block; }
.title { font-size: 38rpx; font-weight: 900; }.subtitle { margin-top: 8rpx; font-size: 22rpx; opacity: .78; }
.content,.form-card { padding: 40rpx 30rpx; }.section-title { text-align: center; font-size: 38rpx; font-weight: 900; }.hint { text-align: center; margin: 10rpx 0 34rpx; color: #64748b; font-size: 24rpx; }
.type-card { min-height: 190rpx; display: flex; align-items: center; gap: 32rpx; padding: 36rpx; margin-bottom: 28rpx; border-radius: 30rpx; color: white; box-shadow: 0 16rpx 34rpx rgba(37,99,235,.18); }.delivery { background: linear-gradient(135deg,#2563eb,#4f46e5); }.outbound { background: linear-gradient(135deg,#f59e0b,#ea580c); }.type-icon { font-size: 70rpx; font-weight: 300; }.type-title { font-size: 42rpx; font-weight: 900; }.type-help { margin-top: 8rpx; font-size: 24rpx; opacity: .8; }
.recent { margin-top: 48rpx; padding: 30rpx; background: white; border-radius: 26rpx; }.recent-title { font-size: 30rpx; font-weight: 900; margin-bottom: 12rpx; }.recent-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-top: 1rpx solid #eef2f7; }.recent-name { font-size: 26rpx; font-weight: 700; }.recent-file { margin-top: 7rpx; max-width: 480rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #94a3b8; font-size: 20rpx; }.status { padding: 8rpx 16rpx; border-radius: 99rpx; background: #eff6ff; color: #2563eb; font-size: 20rpx; }
.form-card { margin: 30rpx; background: white; border-radius: 30rpx; box-shadow: 0 12rpx 40rpx rgba(15,23,42,.08); }.form-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }.form-label { color: #2563eb; font-size: 22rpx; font-weight: 700; }.form-title { font-size: 42rpx; font-weight: 900; }.back { margin: 0; padding: 14rpx 24rpx; line-height: 1.3; background: #f1f5f9; color: #475569; font-size: 24rpx; }.field-label { margin: 24rpx 0 12rpx; color: #475569; font-size: 24rpx; font-weight: 700; }.field,.textarea { box-sizing: border-box; width: 100%; padding: 24rpx; border: 2rpx solid #e2e8f0; border-radius: 18rpx; background: #fff; color: #172033; caret-color: #2563eb; font-size: 28rpx; }.text-input { color: #172033 !important; }.textarea { height: 150rpx; }
.input-shell { padding: 0 24rpx; }
.native-input { box-sizing: border-box; width: 100%; height: 86rpx; line-height: 86rpx; color: #172033; font-size: 28rpx; background: transparent; }
.photo-button { display: flex; flex-direction: column; align-items: center; margin-top: 30rpx; padding: 46rpx 20rpx; border: 3rpx dashed #93c5fd; border-radius: 24rpx; background: #eff6ff; color: #2563eb; }.camera { font-size: 70rpx; line-height: 1; }.photo-title { margin-top: 14rpx; font-size: 30rpx; font-weight: 900; }.photo-help { margin-top: 8rpx; color: #64748b; font-size: 21rpx; }.photo-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; margin-top: 24rpx; }.photo-wrap { position: relative; }.photo { width: 100%; height: 190rpx; border-radius: 14rpx; }.remove { position: absolute; top: -12rpx; right: -12rpx; width: 46rpx; height: 46rpx; min-height: 0; padding: 0; line-height: 42rpx; border-radius: 50%; background: #ef4444; color: white; font-size: 32rpx; }.submit { margin-top: 34rpx; padding: 27rpx; border-radius: 20rpx; background: #2563eb; color: white; font-size: 30rpx; font-weight: 900; }.submit[disabled] { background: #93b4ef; color: rgba(255,255,255,.8); }
